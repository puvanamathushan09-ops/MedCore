generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  email          String          @unique
  passwordHash   String          @map("password_hash")
  role           Role            @default(STUDENT)
  firstName      String          @map("first_name")
  lastName       String          @map("last_name")
  avatarUrl      String?         @map("avatar_url")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  studentProfile StudentProfile?
  articles       Article[]       @relation("UserArticles")

  @@map("users")
}

model StudentProfile {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicalSchool          String?  @map("medical_school")
  yearOfStudy            Int?     @map("year_of_study")
  targetExam             String?  @map("target_exam")
  specializationInterest String?  @map("specialization_interest")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("student_profiles")
}

model Subject {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  slug        String    @unique
  description String?
  iconUrl     String?   @map("icon_url")
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  topics      Topic[]
  articles    Article[] @relation("SubjectArticles")

  @@map("subjects")
}

model Topic {
  id          String    @id @default(uuid()) @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parentId    String?   @map("parent_id") @db.Uuid
  parent      Topic?    @relation("TopicToTopic", fields: [parentId], references: [id], onDelete: Cascade)
  children    Topic[]   @relation("TopicToTopic")
  title       String
  slug        String
  description String?
  orderIndex  Int       @default(0) @map("order_index")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  articles    Article[] @relation("TopicArticles")

  @@map("topics")
}

enum Role {
  STUDENT
  MEDICAL_REVIEWER
  ADMIN
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Article {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  slug             String        @unique
  summary          String?       @db.Text
  content          String        @db.Text
  featuredImageUrl String?       @map("featured_image_url")
  status           ArticleStatus @default(DRAFT)
  authorId         String        @map("author_id") @db.Uuid
  author           User          @relation("UserArticles", fields: [authorId], references: [id], onDelete: Restrict)
  subjectId        String        @map("subject_id") @db.Uuid
  subject          Subject       @relation("SubjectArticles", fields: [subjectId], references: [id], onDelete: Restrict)
  topicId          String?       @map("topic_id") @db.Uuid
  topic            Topic?        @relation("TopicArticles", fields: [topicId], references: [id], onDelete: SetNull)
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@index([authorId])
  @@index([subjectId])
  @@index([topicId])
  @@index([status])
  @@index([createdAt])
  @@map("articles")
}
